{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Uvicorn (Run)",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "envFile": "${workspaceFolder}/.env",
      "console": "integratedTerminal"
    },
    {
      "name": "Python: Uvicorn (Debug)",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--reload",
        "--host",
        "127.0.0.1",
        "--port",
        "8000",
        "--log-level",
        "debug"
      ],
      "envFile": "${workspaceFolder}/.env",
      "jinja": true,
      "console": "integratedTerminal",
      "justMyCode": true,
      "subProcess": true
    }
  ]
}
